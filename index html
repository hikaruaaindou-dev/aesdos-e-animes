<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SEU NOME — Aesthetic & Histórias</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Darker+Grotesque:wght@600;700;800&family=Manrope:wght@400;500;600&family=Permanent+Marker&display=swap" rel="stylesheet">
<style>
  /* =========================================================
     GUIA RÁPIDO DE EDIÇÃO (não aparece no site)
     1) Procure "EDITE AQUI" pra trocar nome, textos e links.
     2) Cores: mude os valores em :root logo abaixo.
     3) Fotos: troque o "placeholder-img" por uma imagem real:
        style="background-image:url('sua-foto.jpg')" (mesma pasta
        do index.html) — ou troque a div por uma tag <img>.
     4) Links de histórias: se você postar em Wattpad/Spirit
        Fanfiction/Inkspired, cole o link real no href="#".
     ========================================================= */

  :root{
    --bg: #17141f;
    --bg2: #201c2c;
    --line: rgba(243,236,223,0.12);
    --ink: #f3ecdf;
    --ink-soft: #b3a8c2;
    --pink: #f5a9c0;
    --mint: #9fe0c4;
    --gold: #e8c56b;
  }

  *{ box-sizing:border-box; }

  body{
    margin:0; background: var(--bg); color: var(--ink);
    font-family:'Manrope', sans-serif; line-height:1.6;
  }
  h1,h2,.brand,.btn{ font-family:'Darker Grotesque', sans-serif; font-weight:800; letter-spacing:0.3px; }
  .sticker-tag{ font-family:'Permanent Marker', cursive; }
  a{ color: var(--pink); }

  .wrap{ max-width: 920px; margin:0 auto; padding: 0 26px; }

  /* NAV */
  nav{
    position: sticky; top:0; z-index:10;
    background: rgba(23,20,31,0.9); backdrop-filter: blur(6px);
    border-bottom:1px solid var(--line);
    padding: 14px 26px; display:flex; justify-content:space-between; align-items:center;
  }
  .brand{ font-size:1.6rem; }
  .brand span{ color: var(--pink); }
  .nav-links{ display:flex; gap:24px; list-style:none; margin:0; padding:0; }
  .nav-links a{ color: var(--ink); text-decoration:none; font-size:0.95rem; font-weight:500; }
  .nav-links a:hover{ color: var(--pink); }
  #nav-toggle{ display:none; background:none; border:none; font-size:1.5rem; color:var(--ink); cursor:pointer; }
  @media (max-width:640px){
    #nav-toggle{ display:block; }
    .nav-links{
      position:absolute; top:100%; left:0; right:0; background:var(--bg2);
      flex-direction:column; gap:0; max-height:0; overflow:hidden; transition:max-height .25s ease;
      border-bottom:1px solid var(--line);
    }
    .nav-links.open{ max-height:240px; }
    .nav-links li{ padding:12px 26px; border-top:1px solid var(--line); }
  }

  /* HERO */
  .hero{
    position:relative; padding: 80px 26px 90px; text-align:center; overflow:hidden;
    background-image: radial-gradient(var(--line) 1.4px, transparent 1.4px);
    background-size: 16px 16px;
    clip-path: polygon(0 0,100% 0,100% 94%,97% 100%,93% 93%,89% 100%,85% 94%,81% 100%,77% 94%,73% 100%,69% 93%,65% 100%,61% 94%,57% 100%,53% 93%,49% 100%,45% 94%,41% 100%,37% 93%,33% 100%,29% 94%,25% 100%,21% 93%,17% 100%,13% 94%,9% 100%,5% 93%,0 100%);
  }
  .hero h1{ font-size: 4.2rem; line-height:0.95; margin: 0 0 10px; }
  .hero h1 em{ font-style:normal; color: var(--pink); }
  .hero .subtitle{ color: var(--ink-soft); font-size:1.05rem; max-width:46ch; margin:0 auto 24px; }
  .btn{
    display:inline-block; font-size:1.3rem; background: var(--pink); color:#17141f;
    padding:8px 26px; border-radius:999px; text-decoration:none;
  }
  .btn:hover{ background: var(--mint); }

  section{ padding: 60px 0; }
  h2.section-title{ font-size:2.4rem; margin:0 0 8px; }
  .section-lead{ color: var(--ink-soft); margin: 0 0 30px; max-width:56ch; }

  /* GALERIA (fotos aesthetic) */
  .gallery{
    display:grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr));
    gap: 22px;
  }
  .shot{
    position:relative; background: var(--bg2); border:1px solid var(--line);
    border-radius: 14px; overflow:hidden;
  }
  .shot:nth-child(odd){ transform: rotate(-1deg); }
  .shot:nth-child(even){ transform: rotate(1deg); }
  .placeholder-img{
    height:190px; display:flex; align-items:center; justify-content:center;
    text-align:center; padding:10px; font-size:0.85rem; color: var(--ink-soft);
    background: repeating-linear-gradient(135deg, #2a2438, #2a2438 10px, #241f30 10px, #241f30 20px);
  }
  .shot .cap{ padding: 10px 12px 14px; font-size:0.88rem; color: var(--ink-soft); }
  .sticker-tag{
    position:absolute; top:10px; left:10px; background: var(--gold); color:#17141f;
    font-size:0.95rem; padding:2px 10px; border-radius:999px; transform: rotate(-4deg);
  }

  /* HISTÓRIAS */
  .story-list{ display:flex; flex-direction:column; gap:0; }
  .story{
    display:grid; grid-template-columns: 56px 1fr auto; gap:16px; align-items:start;
    padding: 20px 0; border-top:1px solid var(--line);
  }
  .story:last-child{ border-bottom:1px solid var(--line); }
  .story .num{ font-family:'Darker Grotesque',sans-serif; font-size:2.2rem; color: var(--line); font-weight:800; }
  .story h3{ margin:0 0 4px; font-size:1.2rem; font-weight:600; }
  .story .genre{ font-size:0.8rem; color: var(--mint); margin-bottom:6px; }
  .story p{ margin:0; color: var(--ink-soft); font-size:0.92rem; max-width:52ch; }
  .story a{ font-size:0.9rem; text-decoration:none; white-space:nowrap; align-self:center; }
  .story a:hover{ text-decoration:underline; }
  @media (max-width:560px){
    .story{ grid-template-columns: 40px 1fr; }
    .story a{ grid-column: 2; }
  }

  /* FANDOMS */
  .badges{ display:flex; flex-wrap:wrap; gap:14px; }
  .badge{
    background: var(--bg2); border:1px solid var(--line); border-radius:10px;
    padding: 10px 16px; font-size:0.95rem; display:flex; align-items:center; gap:8px;
  }
  .badge .dot{ width:8px; height:8px; border-radius:50%; background: var(--pink); }

  /* CONTATO */
  .contact-links{ display:flex; flex-direction:column; gap:10px; font-size:1.02rem; }
  .contact-links a{ text-decoration:none; }
  .contact-links a:hover{ text-decoration:underline; }

  footer{ text-align:center; padding:34px 0 50px; color: var(--ink-soft); font-size:0.88rem; }

  :focus-visible{ outline: 2px solid var(--mint); outline-offset:2px; }
  @media (prefers-reduced-motion: reduce){ *{ transition:none !important; } }
</style>
</head>
